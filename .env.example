# Cross-device live rounds (Supabase Realtime). Optional: without these, live rounds
# work between tabs of the same browser only.
# Set these in .env.local for local work and in Vercel → Settings → Environment Variables.
# Use the project's *publishable* (anon/public) key — never the service_role / secret key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: force same-browser sync even when Supabase is configured.
# NEXT_PUBLIC_SYNC_MODE=local
